<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain-text (http/ws) traffic by default on API 28+. The test server has no
  TLS certificate on its raw IP, so rather than allowing cleartext app-wide (which would also
  weaken any future real HTTPS domain), this carves out an exception for just this one IP.

  When the real server gets a domain name + HTTPS certificate, delete this file, remove the
  android:networkSecurityConfig line from AndroidManifest.xml, and switch API_BASE_URL/WS_URL
  in build.gradle.kts back to https:// / wss://.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">34.64.233.6</domain>
    </domain-config>
</network-security-config>
