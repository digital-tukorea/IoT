<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".fragment.CalendarFragment">

    <LinearLayout
        android:id="@+id/layoutCalendarHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="내 캘린더"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAddEvent2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_mint"
            android:contentDescription="캘린더 앱 열기"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_today"
            app:tint="@color/mint_accent" />

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshCalendar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCalendarHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Month grid card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnPrevMonth"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="이전 달"
                                android:src="@android:drawable/ic_media_previous" />

                            <TextView
                                android:id="@+id/tvMonthLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="2026년 8월"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/ink"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/btnNextMonth"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="다음 달"
                                android:src="@android:drawable/ic_media_next" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView style="@style/WeekdayLabel" android:text="일" android:textColor="#E0685A" />
                            <TextView style="@style/WeekdayLabel" android:text="월" />
                            <TextView style="@style/WeekdayLabel" android:text="화" />
                            <TextView style="@style/WeekdayLabel" android:text="수" />
                            <TextView style="@style/WeekdayLabel" android:text="목" />
                            <TextView style="@style/WeekdayLabel" android:text="금" />
                            <TextView style="@style/WeekdayLabel" android:text="토" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCalendarDays"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                            app:spanCount="7"
                            tools:listitem="@layout/item_calendar_day" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Selected day's events -->
                <TextView
                    android:id="@+id/tvSelectedDayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:text="오늘의 일정"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEvents2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_event" />

                <LinearLayout
                    android:id="@+id/layoutEmptyEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="12dp"
                    android:paddingHorizontal="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이 날은 일정이 없어요"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="편하게 입으셔도 좋아요. 날씨만 고려해서 추천해 드릴게요."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/ink_soft"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Scheduled prep alarms -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:text="설정된 알림"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/ink"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAlarms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_alarm" />

                <TextView
                    android:id="@+id/tvNoAlarms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="8dp"
                    android:text="설정된 알림이 없어요"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/ink_soft" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>